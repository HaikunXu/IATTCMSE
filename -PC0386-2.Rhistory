# run the MSE
foreach(i = 1:nrow(runs)) %dopar% {
IATTCMSE::BET_MSE_IE(
pdir,
HS,
HCR,
OM = runs[i, 5],
itrnum = runs[i, 3],
nquarters,
Mcycle,
n_extra_R,
startquarter,
endquarter,
EM_comp_fleet,
dat_name,
ctl_name,
ss_name,
Scontrol = 0.2,
clean = TRUE,
plot = FALSE,
MSY = TRUE
)
}
stopCluster(cl)
