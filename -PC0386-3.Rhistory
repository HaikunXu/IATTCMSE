# ggsave(file = paste0(Figures, "0.5SMSY_prob.pdf"), h = 10, w = 12)
p_SSMSY <- MSE_final_raw %>%
group_by(HS, HCR, Model, Catchability, itr) %>%
mutate(check = SB > 0.5 * SMSY) %>%
group_by(HS, HCR) %>%
summarise(p = sum(check)/ n())
kable(p_SSMSY, caption = "p(SBR_d) > 0.5 SSBMSY")
# Chunk 10: SBR
SBR <- MSE_final_raw %>%
group_by(HS, HCR, Year) %>%
summarise(low = quantile(SBR, 0.1, na.rm = TRUE),
medium = mean(SBR, na.rm = TRUE),
high = quantile(SBR, 0.9, na.rm = TRUE))
ggplot(data = SBR) +
