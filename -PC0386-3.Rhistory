# ggsave(file = paste0(Figures, "Catch_LL_violin.pdf"), h = 10, w = 12)
Catch_pre <- Catch %>%
rename(Catch_annual_next = Catch_annual) %>%
mutate(year = year + 1)
Catch <- Catch[, 1:7]
Catch_AAV <- left_join(Catch, Catch_pre, by = ) %>%
group_by(HS, HCR, Model, Catchability, itr) %>%
summarise(AAV = sum(abs(Catch_annual - Catch_annual_next), na.rm = TRUE) / sum(Catch_annual_next, na.rm = TRUE)) %>%
group_by(HS, HCR) %>%
summarise(AAV= mean(AAV))
kable(Catch_AAV, caption = "Catch_AAV")
# Chunk 12: average closure
Closure_plot <- MSE_final_raw %>%
group_by(HS, HCR, Year) %>%
summarise(low = quantile(closure, 0.1, na.rm = TRUE),
medium = mean(closure, na.rm = TRUE),
high = quantile(closure, 0.9, na.rm = TRUE))
ggplot(data = Closure_plot) +
