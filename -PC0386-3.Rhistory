mutate(itr = as.factor(itr),
Year = Year / 4 + 1974.875,
year = floor(Year) + 0.5)
Output_MSE <- Output_all %>% filter(year > 2025)
# Chunk 5: save key output
Output_MSE_final <- Output_MSE %>%
mutate(Step = ceiling((year - 2025)/3),
SSMSY = SB / SMSY)
Record_all_final <- Record_all %>%
mutate(Step = as.numeric(Step),
HCR = as.character(HCR)) %>%
select(itr, HCR, HS, Model, Catchability, Steepness, Step, FFMSY, closure, closure_diff, Fcurrent, F30)
MSE_final_raw <- left_join(Output_MSE_final, Record_all_final) %>%
na.omit()
# Chunk 6: F/FMSY
FFMSY<- MSE_final_raw %>%
group_by(HS, HCR, Year) %>%
summarise(low = quantile(Fcurrent/F30, 0.1, na.rm = TRUE),
medium = mean(Fcurrent/F30, na.rm = TRUE),
high = quantile(Fcurrent/F30, 0.9, na.rm = TRUE))
ggplot(data = FFMSY) +
# geom_point(aes(x = Year, y = SBR_d), alpha = 0.05, size = 1, data = MSE_final_raw) +
geom_ribbon(aes(x = Year, ymin = low, ymax = high), alpha = 0.5) +
geom_line(aes(x = Year, y = medium), linewidth = 1.5) +
facet_wrap(~ HCR) +
ylab("F/FMSY") +
xlab("") +
geom_hline(yintercept = 1, linetype = "dashed") +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
theme_bw(20)
# Chunk 7: F/FMSY distribution
ggplot(data = MSE_final_raw) +
geom_density(aes(x = Fcurrent/F30, group = Step, color = Step)) +
facet_wrap(~ HCR) +
ylab("F/FMSY") +
xlab("") +
theme_bw(20)
# Chunk 8: SBR_d
SBR_d <- MSE_final_raw %>%
group_by(HS, HCR, Year) %>%
summarise(low = quantile(SBR_d, 0.1, na.rm = TRUE),
medium = mean(SBR_d, na.rm = TRUE),
high = quantile(SBR_d, 0.9, na.rm = TRUE))
ggplot(data = SBR_d) +
geom_point(aes(x = Year, y = SBR_d), alpha = 0.05, size = 1, data = MSE_final_raw) +
geom_ribbon(aes(x = Year, ymin = low, ymax = high, fill = HCR), alpha = 0.5) +
geom_line(aes(x = Year, y = medium, color = HCR), linewidth = 1.5) +
facet_wrap(~ HCR, nrow = 4) +
ylab("Dynamic spawning biomass ratio") +
xlab("") +
geom_hline(yintercept = 0.2, linetype = "dashed") +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
theme_bw(20) +
theme(legend.position = "none") +
coord_cartesian(ylim = c(0, 0.7))
ggsave(file = paste0(Figures, "SBR_d_all_0.75R.png"), h = 10, w = 12)
ggsave(file = paste0(Figures, "SBR_d_all_0.75R.pdf"), h = 10, w = 12)
ggplot(data = SBR_d) +
geom_line(aes(x = Year, y = medium, color = HCR), linewidth = 1.5) +
ylab("Dynamic spawning biomass ratio") +
xlab("") +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
theme_bw(20) +
coord_cartesian(ylim = c(0, 0.5))
# ggsave(file = paste0(Figures, "SBR_d_mean.png"), h = 10, w = 12)
# ggsave(file = paste0(Figures, "SBR_d_mean.pdf"), h = 10, w = 12)
p_SBR_d <- MSE_final_raw %>%
mutate(check = SBR_d < 0.2) %>%
group_by(HS, HCR) %>%
summarise(p = sum(check)/ n())
kable(p_SBR_d,caption = "p(SBR_d) < 0.2")
ggplot(data = MSE_final_raw) +
geom_violin(aes(x = HCR, y = SBR_d, fill = HCR)) +
geom_hline(yintercept = 0.2, linetype = "dashed") +
ylab("Dynamic spawning biomass ratio") +
xlab("") +
theme_bw(20) +
theme(legend.position = "none")
# ggsave(file = paste0(Figures, "SBR_d_violin.png"), h = 10, w = 12)
# ggsave(file = paste0(Figures, "SBR_d_violin.pdf"), h = 10, w = 12)
p_SBR_d_annual <- MSE_final_raw %>%
mutate(check = SBR_d > 0.2) %>%
group_by(HS, HCR, year) %>%
summarise(p = sum(check)/ n())
ggplot(data = p_SBR_d_annual) +
geom_line(aes(x = year, y = p, color = HCR)) +
theme_bw(20) +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
xlab("") +
ylab("Prob (dynamic spawning biomass ratio > 0.2)")
# ggsave(file = paste0(Figures, "SBR_d_prob.png"), h = 10, w = 12)
# ggsave(file = paste0(Figures, "SBR_d_prob.pdf"), h = 10, w = 12)
# Chunk 9: SMSY
ggplot(data = MSE_final_raw) +
geom_violin(aes(x = HCR, y = SB / SMSY, fill = HCR)) +
geom_hline(yintercept = 0.5) +
ylab("SB / SBmsy") +
xlab("") +
theme_bw(20) +
theme(legend.position = "none")
