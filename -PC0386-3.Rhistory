# Chunk 13: change in closure
ggplot(data = MSE_final_raw) +
geom_histogram(
aes(
x = closure_diff,
y = after_stat(count / tapply(count, PANEL, sum)[PANEL]), # Corrects for facets
fill = HCR
),
binwidth = 1
) +
xlab("Closure change (day)") +
ylab("Proportion") + # Updated label to match the scale
facet_wrap(~ HCR, nrow = 4) +
scale_y_continuous(labels = scales::percent) +
theme_bw(20)
