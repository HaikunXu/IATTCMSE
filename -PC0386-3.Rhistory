coord_cartesian(ylim = c(0, 1.5e5)) +
theme_bw(20)
# ggsave(file = paste0(Figures, "Longline_catch.png"), h = 10, w = 12)
# ggsave(file = paste0(Figures, "Longline_catch.pdf"), h = 10, w = 12)
p_Catch_LL <- Catch_LL %>%
mutate(Flag = Catch_annual > 55000) %>%
group_by(HS, HCR) %>%
summarise(p_Catch_LL = sum(Flag) / n())
kable(p_Catch_LL, caption = "p_Catch_LL")
# Chunk 19: Catch by PS
Catch_PS <- MSE_final_raw %>%
filter(is.na(Catch) == FALSE) %>%
group_by(HS, HCR, Model, Catchability, itr, year) %>%
summarise(Catch_annual = sum(Catch_PS))
Catch_PS_old <- Output_all %>%
filter(year < 2025) %>%
filter(is.na(Catch) == FALSE) %>%
group_by(HS, HCR, Model, Catchability, itr, year) %>%
summarise(Catch_annual = sum(Catch_PS)) %>%
group_by(year) %>%
summarise(Catch_annual = mean(Catch_annual))
Catch_PS_plot <- Catch_PS %>%
group_by(HS, HCR, year) %>%
summarise(low = quantile(Catch_annual, 0.1, na.rm = TRUE),
medium = mean(Catch_annual, na.rm = TRUE),
high = quantile(Catch_annual, 0.9, na.rm = TRUE))
ggplot(data = Catch_PS_plot) +
geom_ribbon(aes(x = year, ymin = low, ymax = high, fill = HCR), alpha = 0.2) +
geom_line(aes(x = year, y = medium, color = HCR), linewidth = 1.5) +
geom_line(aes(x = year, y = Catch_annual), linewidth = 1.5, data = Catch_PS_old) +
ylab("Annual purse-seine catch (mt)") +
xlab("") +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
theme_bw(20)
# ggsave(file = paste0(Figures, "PS_catch.png"), h = 10, w = 12)
# ggsave(file = paste0(Figures, "PS_catch.pdf"), h = 10, w = 12)
# Chunk 20: Catch
Catch <- MSE_final_raw %>%
filter(is.na(Catch) == FALSE) %>%
group_by(HS, HCR, Model, Catchability, itr, year) %>%
summarise(Catch_annual = sum(Catch))
Catch_old <- Output_all %>%
filter(year < 2025) %>%
filter(is.na(Catch) == FALSE) %>%
group_by(HS, HCR, Model, Catchability, itr, year) %>%
summarise(Catch_annual = sum(Catch)) %>%
group_by(year) %>%
summarise(Catch_annual = mean(Catch_annual))
Catch_plot <- Catch %>%
group_by(HS, HCR, year) %>%
summarise(low = quantile(Catch_annual, 0.1, na.rm = TRUE),
medium = mean(Catch_annual, na.rm = TRUE),
high = quantile(Catch_annual, 0.9, na.rm = TRUE))
ggplot(data = Catch_plot) +
geom_ribbon(aes(x = year, ymin = low, ymax = high, fill = HCR), alpha = 0.2) +
geom_line(aes(x = year, y = medium, color = HCR), linewidth = 1.5) +
geom_line(aes(x = year, y = Catch_annual), linewidth = 1.5, data = Catch_old) +
ylab("Annual total catch (mt)") +
xlab("") +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
theme_bw(20) +
coord_cartesian(ylim = c(0, 2e5))
# ggsave(file = paste0(Figures, "Total_catch.png"), h = 10, w = 12)
# ggsave(file = paste0(Figures, "Total_catch.pdf"), h = 10, w = 12)
PIs <- data.frame(
"HCR" = Catch_stats$HCR,
"p_dSBR" = round(1 - p_SBR_d$p, 3) * 100,
"p_SBR" = round(1 - p_SBR$p, 3) * 100,
"p_0.5SMSY" = round(p_SSMSY$p, 3) * 100,
"p_Kobe" = round(p_Kobe$p_Kobe, 3) * 100,
"AAV" = round(Catch_AAV$AAV * 100, 1),
"p_20" = round(p_closure_change$p_20, 3) * 100,
"Total_catch" = round(Catch_stats$Catch_total),
"Total_PS" = round(Catch_stats$Catch_PS),
"Total_LL" = round(Catch_stats$Catch_LL),
"Closure" = round(Closure_stats$ave_closure),
"CPUE_ratio" = round(p_CPUE$p_CPUE, 2)
)
kable(PIs, caption = "Performance indicators")
