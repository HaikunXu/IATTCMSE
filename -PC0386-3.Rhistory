group_by(HS, HCR, Model, Catchability, itr) %>%
summarise(closure_d = mean(abs(closure_diff))) %>%
group_by(HS, HCR) %>%
summarise(ave_closure_diff = mean(closure_d))
kable(Closure_change_stats, caption = "Closure_diff")
p_closure_change <- MSE_final_raw %>%
group_by(HS, HCR) %>%
summarise(p_20 = sum(closure_diff==20)/n())
kable(p_closure_change, caption = "p_closure_change")
# Chunk 14: Kobe statistics
