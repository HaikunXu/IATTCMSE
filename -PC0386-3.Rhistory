Catch_stats <- Catch %>%
group_by(HS, HCR) %>%
summarise(Catch_total = mean(Catch_annual),
Catch_LL = mean(Catch_LL),
Catch_PS = mean(Catch_PS))
kable(Catch_stats, caption = "Catch")
ggplot(data = Catch) +
geom_violin(aes(x = HCR, y = Catch_annual, fill = HCR)) +
ylab("Annual total catch (mt)") +
xlab("") +
theme_bw(20) +
theme(legend.position = "none")
# # ggsave(file = paste0(Figures, "Catch_violin.png"), h = 10, w = 12)
# # ggsave(file = paste0(Figures, "Catch_violin.pdf"), h = 10, w = 12)
Catch_LL <- MSE_final_raw %>%
filter(is.na(Catch) == FALSE) %>%
group_by(HS, HCR, Model, Catchability, itr, year) %>%
summarise(Catch_annual = sum(Catch_LL))
ggplot(data = Catch_LL) +
geom_violin(aes(x = HCR, y = Catch_annual, fill = HCR)) +
geom_hline(yintercept = 55131) +
ylab("Annual longline catch (mt)") +
xlab("") +
