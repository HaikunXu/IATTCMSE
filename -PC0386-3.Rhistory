# Chunk 16: trade-off
Catch <- MSE_final_raw %>%
filter(is.na(Catch) == FALSE) %>%
group_by(HS, HCR, Model, Catchability, itr, year) %>%
summarise(Catch_annual = sum(Catch_PS)) %>%
group_by(HS, HCR) %>%
summarise(ave_catch = mean(Catch_annual),
low_catch = quantile(Catch_annual, 0.1),
high_catch = quantile(Catch_annual, 0.9))
dSBR <- MSE_final_raw %>%
group_by(HS, HCR) %>%
summarise(ave_dSBR = mean(SBR_d),
low_dSBR = quantile(SBR_d, 0.1),
high_dSBR = quantile(SBR_d, 0.9))
Kobe <- MSE_final_raw %>%
mutate(Flag = (SSMSY > 1) & (FFMSY < 1)) %>%
group_by(HS, HCR) %>%
summarise(ave_Kobe = sum(Flag)/n() * 100)
Closure <- MSE_final_raw %>%
group_by(HS, HCR) %>%
summarise(ave_closure = mean(closure),
low_closure = quantile(closure, 0.1),
high_closure = quantile(closure, 0.9))
Tradeoff <- left_join(left_join(Kobe, Closure), Catch) %>%
data.frame()
ggplot(data = Tradeoff) +
xlab("Closure (day)") +
ylab("Prob that Kobe is in green (%)") +
geom_vline(xintercept = 72, linetype = "dashed") +
geom_label_repel(aes(x = ave_closure, y = ave_Kobe, label = HCR),
box.padding = 2,
point.padding = 2,
size = 6) +
geom_point(aes(x = ave_closure, y = ave_Kobe, color = ave_catch), size = 5) +
scale_color_distiller(palette = "Spectral") +
theme_bw(20) +
labs(color = "PS catch") +
coord_cartesian(xlim = c(0, 100), ylim = c(80, 100), expand = FALSE)
