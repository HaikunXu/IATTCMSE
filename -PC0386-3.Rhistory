geom_ribbon(aes(x = Year, ymin = low, ymax = high, fill = HCR), alpha = 0.5) +
geom_line(aes(x = Year, y = medium, color = HCR), linewidth = 1.5) +
geom_hline(yintercept = 0.077) +
ylab("Spawning biomass ratio") +
xlab("") +
facet_wrap(~ HCR, nrow = 4) +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
