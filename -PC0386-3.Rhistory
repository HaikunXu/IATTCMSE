group_by(HS, HCR) %>%
summarise(p_Kobe = sum(Flag)/n())
kable(p_Kobe, caption = "Kobe in green")
p_Kobe_annual <- MSE_final_raw %>%
mutate(Flag = (SSMSY > 1) & (FFMSY < 1)) %>%
group_by(HS, HCR, year) %>%
summarise(p_Kobe = sum(Flag)/n())
ggplot(data = p_Kobe_annual) +
