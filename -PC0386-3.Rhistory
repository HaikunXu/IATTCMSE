# ggsave(file = paste0(Figures, "Trade-off.pdf"), h = 10, w = 12)
# Chunk 17: CPUE
ave_CPUE <- Output_all %>%
na.omit() %>%
filter(Year > 2017, Year < 2020) %>%
summarise(ave = mean(CPUE))
CPUE <- MSE_final_raw %>%
group_by(HS, HCR, Year) %>%
summarise(low = quantile(CPUE, 0.1, na.rm = TRUE),
medium = mean(CPUE, na.rm = TRUE),
high = quantile(CPUE, 0.9, na.rm = TRUE))
CPUE_old <- Output_all %>%
filter(Year < 2025) %>%
group_by(Year) %>%
summarise(medium = mean(CPUE, na.rm = TRUE))
ggplot(data = CPUE) +
geom_ribbon(aes(x = Year, ymin = low, ymax = high, fill = HCR), alpha = 0.2) +
geom_line(aes(x = Year, y = medium, color = HCR), linewidth = 1.5) +
geom_hline(yintercept = ave_CPUE$ave, linetype = "dashed") +
ylab("Longline CPUE") +
geom_line(aes(x = Year, y = medium), linewidth = 1.5, data = CPUE_old) +
xlab("") +
geom_vline(xintercept = 2025 + seq(Mcycle, nyears - Mcycle, Mcycle), linetype = "dashed") +
coord_cartesian(ylim = c(0, 7.5e7)) +
theme_bw(20)
p_CPUE <- MSE_final_raw %>%
na.omit() %>%
mutate(Ratio = CPUE / ave_CPUE$ave) %>%
group_by(HS, HCR) %>%
summarise(p_CPUE = mean(Ratio))
kable(p_CPUE, caption = "p_CPUE")
